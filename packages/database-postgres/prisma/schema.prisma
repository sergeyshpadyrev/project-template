datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  Done       @map("done")
  InProgress @map("in-progress")
  Todo       @map("todo")
}

model Project {
  id    String @id @default(uuid())
  name  String
  tasks Task[]
}

model Task {
  id          String     @id @default(uuid())
  description String
  name        String
  status      TaskStatus
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model User {
  id   String @id @default(uuid())
  name String
}
